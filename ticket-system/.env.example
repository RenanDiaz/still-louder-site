# =============================================================================
# WWWY3 Ticket System — environment variables
# =============================================================================
# Set these in the Vercel project (Settings -> Environment Variables).
# Everything here is SERVER-ONLY. None of these are exposed to the browser:
# the frontend never imports them and Vite only inlines vars prefixed VITE_.
# =============================================================================

# --- Supabase (server-side only) --------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
# From address — domain must be verified in Resend (DKIM/SPF/DMARC).
EMAIL_FROM="Still Louder <entradas@stilllouder.space>"
# Internal recipient(s) notified when a purchase is registered (order created).
# Optional: leave empty to disable. Accepts a comma-separated list of addresses.
ORDER_NOTIFICATION_EMAIL=

# --- QR signing --------------------------------------------------------------
# Long random secret. Generate with: openssl rand -hex 32
TICKET_HMAC_SECRET=

# --- Access gates ------------------------------------------------------------
ADMIN_PASSWORD=
STAFF_PASSWORD=

# --- CuantoApp (card payments, manual reconciliation) -----------------------
# Checkout link shown to buyers who choose card. Optional in M1.
CUANTOAPP_PAYMENT_URL=

# --- Cron ---------------------------------------------------------------------
# Set this in Vercel so the hourly cleanup cron can authenticate itself.
# Generate with: openssl rand -hex 16
CRON_SECRET=

# --- Yappy Botón de Pago V2 (server-only; NO VITE_ prefix, never in Git) ----
# From the Yappy merchant portal (Métodos de cobro -> Botón de Pago Yappy).
# Leaving these empty hides the Yappy option in the buyer flow.
YAPPY_BTN_MERCHANT_ID=
# Base64 string exactly as shown (only once!) by the portal.
YAPPY_BTN_SECRET_KEY=
# Must match the domain configured in the portal.
YAPPY_BTN_DOMAIN=https://entradas.stilllouder.space
# test = UAT endpoints/CDN · prod = production
YAPPY_BTN_ENV=test
# Optional: override the web-component CDN URL (the doc lists two prod variants).
YAPPY_BTN_CDN_URL=

# --- Optional ----------------------------------------------------------------
# Public base URL of this deployment, used to build links in emails.
PUBLIC_BASE_URL=https://entradas.stilllouder.space
