// Cloudflare Workers config for the TICKET SYSTEM (entradas.still-louder.com).
// One Worker serves both halves of the app:
//   - static assets: the Vite multi-page build in dist/
//   - /api/*: the existing Vercel-style handlers, adapted by cloudflare/worker.ts
//
// Deploy:   npm run deploy:cloudflare      (build + wrangler deploy)
// Preview:  npm run preview:cloudflare     (build + wrangler dev)
// Env:      non-sensitive, domain-bound values live in "vars" below; everything
//           else is a secret (`wrangler secret put <NAME>`). A name can't be both.
//           See docs/deploy-cloudflare.md (repo root) for the full list.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "still-louder-tickets",
  "main": "cloudflare/worker.ts",
  // With nodejs_compat and a compatibility date >= 2025-04-01, node:crypto /
  // Buffer work and process.env is populated from vars + secrets, so the
  // api/ code reads its configuration unchanged.
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],

  // The bundler would otherwise pick qrcode's "browser" build, which lacks
  // toBuffer() (it renders via <canvas>). Force the Node build — its pngjs /
  // node:zlib / node:stream dependencies all exist under nodejs_compat.
  "alias": {
    "qrcode": "qrcode/lib/index.js"
  },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // cleanUrls + trailingSlash:false equivalent (entradas.html -> /entradas).
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // Only API requests invoke the Worker; every other path is served as a
    // static asset directly (honoring dist/_headers and dist/_redirects).
    "run_worker_first": ["/api/*"]
  },

  // Mirror of vercel.json "crons": daily cleanup of expired pending orders.
  // (Cloudflare has no hourly-cron restriction; tighten the schedule here if
  // desired — the endpoint is idempotent housekeeping.)
  "triggers": {
    "crons": ["0 6 * * *"]
  },

  "observability": {
    "enabled": true
  },

  // Non-sensitive config only (this file is public). Secrets go through
  // `wrangler secret put`. Locally, .dev.vars overrides these — set
  // YAPPY_BTN_ENV=test there so `wrangler dev` never hits Yappy prod.
  "vars": {
    "PUBLIC_BASE_URL": "https://entradas.still-louder.com",
    "YAPPY_BTN_DOMAIN": "https://entradas.still-louder.com",
    "YAPPY_BTN_ENV": "prod",
    // Switch to still-louder.com only once that domain is verified in Resend.
    "EMAIL_FROM": "Still Louder <entradas@stilllouder.space>"
  },

  // Custom domain. Requires the still-louder.com zone on this Cloudflare
  // account; deploy creates the DNS record + certificate. PUBLIC_BASE_URL and
  // YAPPY_BTN_DOMAIN (vars above) and the domain registered in the Yappy
  // portal MUST match this host, or the Yappy button / IPN fail.
  "workers_dev": true,
  "routes": [
    { "pattern": "entradas.still-louder.com", "custom_domain": true }
  ]
}
