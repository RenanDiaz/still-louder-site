# Cloudflare `_headers` — security headers of the ticket system's static assets
# (wrangler.jsonc). Only applies to static-asset responses; /api/* headers are
# set by cloudflare/adapter.ts — keep the shared directives in sync there.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com https://*.yappy.cloud https://*.yappycloud.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.google-analytics.com https://www.googletagmanager.com https://*.yappy.cloud https://*.yappycloud.com; connect-src 'self' https://*.supabase.co https://*.yappy.cloud https://*.yappycloud.com https://apipagosbg.bgeneral.cloud https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; font-src 'self' data: https://*.yappy.cloud https://*.yappycloud.com; frame-src https://*.yappy.cloud https://*.yappycloud.com; media-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# The hidden gift-claim surface must never be indexed (its URL is the secret).
/regalo
  X-Robots-Tag: noindex, nofollow

/regalo/*
  X-Robots-Tag: noindex, nofollow
