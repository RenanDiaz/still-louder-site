# Cloudflare `_redirects` — page rewrites and redirects (API routing lives in
# the Worker router, cloudflare/worker.ts). Status 200 = rewrite, the URL stays
# as typed; 301 = permanent redirect.

/when-we-were-young-3 /entradas 200
/regalo/* /regalo 200

# Old public path of the Halloween Party show (still on flyers/links).
/31-10 /halloween-party 301

# Root: real HTTP redirect so crawlers (Facebook, WhatsApp) reach the page
# with the OG tags; index.html's meta-refresh stays as a fallback.
/ /entradas 301
