# Ignore OS files
.DS_Store

# Ignore Vercel build output
.vercel

# Ignore Cloudflare Wrangler local state
.wrangler/

# Ignore local environment files
.env

# Node modules and dependencies
node_modules/
package-lock.json
# The ticket system pins its deploy toolchain (wrangler): Workers Builds
# must install the exact same versions every time.
!ticket-system/package-lock.json
yarn.lock
pnpm-lock.yaml

# Build outputs
dist/
build/
.vite/

# Editor directories
.vscode/*
!.vscode/extensions.json
.idea

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cache
.cache/
.parcel-cache/

# Optimized image backups
*-optimized.jpg
*-optimized.png

# Original/RAW sources of the web images (multi-MB, never deployed).
# optimize-images.js reads them from their target folder while running; park them here afterwards.
originals/
